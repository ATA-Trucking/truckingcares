<article class="testimonial-node-v4">      
   <div class="testimonial-content">
      <div class="content">         
         <div class="content-inner">
            <div class="quote">{{ fields.body.content|striptags|trim }}</div>  
            <div class="info">
               <span class="title">{{ fields.field_testimonial_name.content }}{{' .'|t}}</span>  
               <span class="job">{{ fields.field_testimonial_job.content }}</span>   
            </div> 
         </div>    
      </div>
   </div>
</article>
